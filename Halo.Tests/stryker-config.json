{
  "stryker-config": {
    "project": "Halo.csproj",
    "test-runner": "mtp",
    "coverage-analysis": "off",
    "concurrency": 4,
    "additional-timeout": 30000,
    "mutate": [
      "**/*.cs",
      "!**/YMM4-GitHubUpdateNotifier/**",
      "!**/YMM4-Telemetry/**",
      "!**/HaloTelemetry.cs",
      "!**/HaloUpdateNotifier.cs"
    ],
    "reporters": [
      "progress",
      "cleartext",
      "html"
    ]
  }
}
